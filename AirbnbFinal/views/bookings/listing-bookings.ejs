<% layout("/layouts/boilerplate.ejs") %>

<div class="show-wrapper">
  <h2 class="mt-3 mb-4">Bookings for This Listing</h2>

  <% if(bookings.length === 0) { %>
    <p>No bookings yet for this listing.</p>
  <% } else { %>
    <% bookings.forEach(booking => { %>
      <div class="card mb-3 p-3">
        <p class="mb-1">Booked by: <b><%= booking.user.username %></b></p>
        <p class="mb-1">Check-in: <%= booking.checkIn.toDateString() %></p>
        <p class="mb-1">Check-out: <%= booking.checkOut.toDateString() %></p>
        <p class="mb-0">Total: ₹<%= booking.totalPrice.toLocaleString("en-IN") %></p>
      </div>
    <% }) %>
  <% } %>
</div>