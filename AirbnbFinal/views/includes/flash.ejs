<% if(successMsg && successMsg.length) { %>  
  <div class="alert alert-success alert-dismissible fade show mt-3 alert-responsive" role="alert">
    <p class="fs-5"><%= successMsg %></p>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
  <% } %>

<% if(failureMsg && failureMsg.length) { %>  
  <div class="alert alert-danger alert-dismissible fade show mt-3 alert-responsive" role="alert">
    <p class="fs-4"><%= failureMsg %></p>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
  <% } %>

