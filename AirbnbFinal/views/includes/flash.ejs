<% if(successMsg && successMsg.length) { %>  
  <div class="alert alert-success alert-dismissible fade show mt-3 fs-3 col-6 offset-1" role="alert">
    <p><%= successMsg %></p>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
  <% } %>

<% if(failureMsg && failureMsg.length) { %>  
  <div class="alert alert-danger alert-dismissible fade show mt-3 fs-3 col-6 offset-1" role="alert">
    <p><%= failureMsg %></p>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
  <% } %>

