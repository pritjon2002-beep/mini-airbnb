<% layout("/layouts/boilerplate.ejs") %>
  
<div class="show-wrapper">
  <div class="mb-0">
    <h2 class=" mt-3  show-header ms-1"><%= listing.title %></h2>
  </div>
<div class="card listing-card mt-2 " >
   <img src="<%= listing.image.url  %>" class=" show-img " alt="Listing_Image">
  <div class="card-body">    
    <p class="card-text mt-3 mb-0">Owner : <i><%= listing.owner.username %></i></p>
    <p class="description"><%= listing.description %></p> 
    &#8377 &nbsp;<%=  listing.price.toLocaleString("en-IN") %><br>
    <%= listing.location %><br>
    <%= listing.country %><br>
      </div>

 
</div>
<% if(currUser && currUser._id.equals(listing.owner._id)) {%>
<div class=" d-flex mt-2 pb-3">  
 <a href="/listings/<%= listing.id %>/edit"><button class="btn btn-danger">Edit Listing</button></a>
 <form action="/listings/<%= listing._id %>?_method=delete " method="post" onsubmit="return confirm('Are you sure to delete this Listing')">
    <button class="btn btn-dark ms-2">
    Delete Listing
    </button>
 </form>
</div>
 <% } %>

 // book now 
 <% if(currUser && !listing.owner._id.equals(currUser._id))  { %>
<div class="mt-4 mb-4">
  <h4>Book This Place</h4>
  <form action="/listings/<%= listing.id %>/bookings" method="POST" class="needs-validation" novalidate>
    <div class="row g-2">
      <div class="col-6">
        <label for="checkIn" class="form-label">Check-in</label>
        <input type="date" name="booking[checkIn]" id="checkIn" class="form-control" required>
      </div>
      <div class="col-6">
        <label for="checkOut" class="form-label">Check-out</label>
        <input type="date" name="booking[checkOut]" id="checkOut" class="form-control" required>
      </div>
    </div>

    <p class="mt-3 fs-5">Total: ₹<span id="totalPrice">0</span></p>

    <button type="submit" class="btn btn-danger">Book Now</button>
  </form>
</div>
<% } %>

  <div class="mt-2"> 
    <h3 class="fs-3">Where You'll Be  </h3>
    <!-- map render -->
  <div class="mt-3 mb-3 mx-auto" id="map" style="height: 400px; "></div>

  <script>
    const listingGeometry = <%- JSON.stringify(listing.geometry) %>;
    const listingTitle = "<%= listing.title %>";
  </script>
   <!-- map render script -->
  <script src="/js/map.js"></script>
</div>

<% if(currUser) {%>
<div class="col-8 mt-4 w-100">
  <h4>Leave a Review : </h4>
  <div class="mt-2">
    <form action="/listings/<%= listing.id %>/reviews" method="post" class="needs-validation" novalidate>

      <fieldset class="starability-heartbeat">
        <legend class="mb-0">Rating:</legend>
        <input type="radio" id="rate1" name="review[rating]" value="1" />
        <label for="rate1" title="Terrible">1 star</label>

        <input type="radio" id="rate2" name="review[rating]" value="2" />
        <label for="rate2" title="Not good">2 stars</label>

        <input type="radio" id="rate3" name="review[rating]" value="3" />
        <label for="rate3" title="Average">3 stars</label>

        <input type="radio" id="rate4" name="review[rating]" value="4" />
        <label for="rate4" title="Very good">4 stars</label>

        <input type="radio" id="rate5" name="review[rating]" value="5" />
        <label for="rate5" title="Amazing">5 stars</label>

        <input type="radio" id="no-rate" name="review[rating]" value="1" checked />
      </fieldset>

      <div class="review-experience">
        <label for="comment" class="form-label  mt-2">Describe Your Experience : </label>
        <textarea required name="review[comment]" id="comment" class="form-control" rows="6" cols="10"></textarea>
        <div class="valid-feedback">Valid-READY TO SUBMIT</div>
        <div class="invalid-feedback">IT SHOULD NOT BE EMPTY</div>
      </div>

      <button class="btn btn-outline-dark mt-4">Submit</button>
    </form>
  </div>
</div>
<br>
<br>
<% } %>

<% if(listing.reviews.length > 0) { %>
<div class="row mb-4 ">
  <h4>Recenty Leaved Reviews </h4>
  <% for(let review of listing.reviews){ %>
  <div class="card added-review col-5 m-3">
    <div class="card-body mb-3 mt-3">
      <h5 class="card-title"> @ <i><%= review.author.username %> </i></h5>
      <p class="starability-result" data-rating="<%= review.rating %>"><%= review.rating %></p>
      <p class="card-text fs-5"><i><%= review.comment %></i></p>
    </div>
    <form action="/listings/<%= listing.id %>/reviews/<%= review._id %>?_method=DELETE" method="post" class="mb-3" onsubmit="return confirm('are you sure to delete this review')">
      <button class="btn btn-sm btn-warning">Delete</button>
    </form>
  </div>
  <% } %>
</div>
<% } %>

 </div>
</div>


