<% layout("/layouts/boilerplate.ejs") %>
<div class="show-wrapper">
    <h2>
      <div class="m-4 ">
        <span
          style="
            display: inline-block;
            padding: 0 20px;
            border-bottom: 3px solid black;
          "
        >
          Create A New Listing
        </span>
      </div>
    </h2>

    <form action="/listings" method="post" class="needs-validation" enctype="multipart/form-data" novalidate>
      <div class="mt-3">
        <label for="title" class="form-label">Enter &nbsp; Title :</label>
        <input
          name="listing[title]"
          type="text"
          placeholder="Enter a good Title "
          id="title"
          class="form-control"
          required
        />
        <div class="valid-feedback">Title Looks Good</div>
        <div class="invalid-feedback">Enter a Valid Title</div>
      </div>

      <div class="mt-3">
        <label for="description" class="form-label"
          >Enter &nbsp; Description :</label
        >
        <textarea
          name="listing[description]"
          placeholder="Enter suitable description "
          id="description"
          class="form-control"
          required
        ></textarea>
        <div class="valid-feedback">Description Looks Good</div>
        <div class="invalid-feedback">Enter a Valid Description</div>
      </div>

      <div class="mb-3 mt-3">
  <label class="form-label d-block">Select Categories : </label>
  <div class="d-flex flex-wrap gap-2">
    <% ["Trending","Rooms","Mountains","Amazing Pools","Iconic Cities","Castles","Camping","Farms","Arctic","Cabins","Tiny Homes"].forEach((cat, i) => { %>
      <input type="checkbox" class="btn-check" name="listing[category]" id="cat<%= i %>" value="<%= cat %>" autocomplete="off">
      <label class="btn btn-outline-dark btn-sm" for="cat<%= i %>"><%= cat %></label>
    <% }) %>
  </div>
</div>

      <div class="mt-3">
        <label for="image" class="form-label">
          Upload &nbsp; Image  :</label
        >
        <input
          id="image"
          class="form-control"
          name="listing[image]"
          type="file"
          placeholder="Enter image url"
          required
        />
      </div>
      <div class="row">
        <div class="mt-3 col-md-4">
          <label for="price" class="form-label">Enter &nbsp; Price :</label>
          <input
            id="price"
            class="form-control"
            name="listing[price]"
            type="number"
            step="100"
            placeholder="Enter Price"
            required
          />
          <div class="valid-feedback">Valid Price</div>
          <div class="invalid-feedback">Enter a Valid Price</div>
        </div>
        <div class="mt-3 col-md-8">
          <label for="country" class="form-label">Enter &nbsp; Country :</label>
          <input
            id="country"
            class="form-control"
            name="listing[country]"
            type="text"
            placeholder="Enter Country "
            required
          />
          <div class="valid-feedback">Valid Country Name</div>
          <div class="invalid-feedback">Enter a Valid Country Name</div>
        </div>
      </div>
      <div class="mt-3">
        <label for="location" class="form-label">Enter &nbsp; Location :</label>
        <input
          id="location"
          class="form-control"
          name="listing[location]"
          type="text"
          placeholder="Enter location "
          required
        />
        <div class="valid-feedback">Valid Location</div>
        <div class="invalid-feedback">Enter a Valid Location</div>
      </div>

      <div class="mt-3">
        <button
          type="submit"
          class="btn btn-danger  mt-2"
          style="width: 40vw"
        >
          Add Listing
        </button>
      </div>
    </form>
  </div>
