<% layout("/layouts/boilerplate.ejs") %>

  <h2>
    <div class="text-center m-4">
      <span
        style="
          display: inline-block;
          padding: 0 10px;
          border-bottom: 3px solid black;
        "
      >
        Edit Your New Listing
      </span>
    </div>
  </h2>
 <div class="show-wrapper">
      <form
        action="/listings/<%= listing._id  %>?_method=PUT"
        method="POST"
        style="align-items: center"
        class="needs-validation"
        novalidate
      enctype="multipart/form-data"
      >
        <div class="mb-3">
          <label for="title" class="form-label">Title : </label>
          <input
            id="title"
            name="listing[title]"
            type="text"
            value="<%= listing.title %>"
            class="form-control"
            style="height: 50px"
            required
          />
          <div class="valid-feedback">Title Looks Good</div>
        <div class="invalid-feedback">Enter a Valid Title</div>
        </div>
        <div class="mb-3">
          <label for="description" class="form-label">Description : </label>
          <input
            id="description"
            name="listing[description]"
            type="text"
            value="<%= listing.description %>"
            class="form-control"
            style="height: 50px"
            required
          />
          <div class="valid-feedback">Description Looks Good</div>
        <div class="invalid-feedback">Enter a Valid Description</div>
        </div>

        <div class="mb-3">
  <label class="form-label d-block">Categories</label>
  <div class="d-flex flex-wrap gap-2">
    <% ["Trending","Rooms","Mountains","Amazing Pools","Iconic Cities","Castles","Camping","Farms","Arctic","Cabins","Tiny Homes"].forEach((cat, i) => { %>
      <input 
        type="checkbox" 
        class="btn-check" 
        name="listing[category]" 
        id="editCat<%= i %>" 
        value="<%= cat %>" 
        autocomplete="off"
        <%= listing.category && listing.category.includes(cat) ? "checked" : "" %>
      >
      <label class="btn btn-outline-dark btn-sm" for="editCat<%= i %>"><%= cat %></label>
    <% }) %>
  </div>
</div>

        <div class="mb-3" >
          <h2 class="fs-4">Listing Image</h2>
          <img src="<%=finalImage%>" alt="" >
        </div>

        <div class="mb-3">
          <label for="image" class="form-label">Image: </label>
          <input
            id="image"
            name="listing[image]"
            type="file"
            class="form-control "
            style="height: 50px"
          />
           
        </div>

        <div class="mb-3">
          <label for="location">Location</label>
          <input
            id="location"
            name="listing[location]"
            type="text"
            value="<%= listing.location %>"
            class="form-control"
            style="height: 50px"
            required
          />
            <div class="valid-feedback">Valid Location</div>
        <div class="invalid-feedback">Enter a Valid Location</div>
        </div>

        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price">Price : </label>
            <input
              id="price"
              name="listing[price]"
              type="number"
              value="<%= listing.price %>"
              class="form-control"
              style="height: 50px"
              step="500"
              required
            />
              <div class="valid-feedback">Valid Price</div>
        <div class="invalid-feedback">Enter a Valid Price</div>
          </div>
          <div class="mb-3 col-md-8">
            <label for="country">Country : </label>
            <input
              id="country"
              name="listing[country]"
              type="text"
              value="<%= listing.country %>"
              class="form-control"
              style="height: 50px"
              required
            />
              <div class="valid-feedback">Valid Country Name</div>
        <div class="invalid-feedback">Enter a Valid Country Name</div>
          </div>
        </div>
        <button class="btn btn-danger mt-3" style="height: 50px" type="submit">
          Edit Listing
        </button>
      </form>
    </div>


